generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageUrl    String
  cookTime    String
  category    String
  servings    Int

  ingredients Ingredient[]
  directions  Direction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id     Int    @id @default(autoincrement())
  amount String
  name   String

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Direction {
  id          Int    @id @default(autoincrement())
  stepNumber  Int
  instruction String

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
}
